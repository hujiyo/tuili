-- 实验二：把「证不出来的东西」交给内核，看它拒收。
--
-- 这不是说"系统证明它不成立"，而是：内核**拒绝**了这个伪证明项。
-- 二者在逻辑上不同，但对工程判定而言是同一件事——
-- 没有构造，就没有定理。想要它，只能加公理。

axiom 假 : Prop
  source text "经典逻辑" locator "假常量" note "只声明命题常量，不断言它成立"
def 非 : Prop → Prop := λ (p : Prop) := p → 假

-- 伪证明：想从 ¬¬p 直接得到 p。
-- 在构造性系统里，唯一可用的手段是把 ¬¬p 展开成 (p→假)→假，
-- 而要得到 p，必须能从 (p→假) 造出 假——可你手上只有 p→假，没有 p。
-- 下面这个项是错的：它试图把 `n'` 当成 p 来用。
def 伪消去 : ∀ (p : Prop), 非 (非 p) → p :=
  λ (p : Prop) := λ (n : 非 (非 p)) := n

-- 上面那行会被内核拒收；这一行只是格式占位，保证文件能继续解析。
#check 伪消去
