-- 实验二：同一个论证，换公理，内核判定不同。
--
-- 论证：从「今天下雨」推出「并非并非今天下雨」。
--   · 只用 → 规则（否定被展开成 →）→ 内核接受，这是**定理**。
--
-- 论证：从「并非并非今天下雨」推出「今天下雨」。
--   · 需要经典双重否定消去 → 这条公理不在账本里就推不出。
--   · 这不是内核决定的，是**理论**决定的：加不加那行 axiom，由你。

sort 天气

pred 下雨 : 天气 → Prop

obj 今天 : 天气

axiom 今天确实下雨 : 下雨 今天
  source text "教学示例" locator "天气事实" note "教学示例事实，非真实观测"

axiom 假 : Prop
  source text "经典逻辑" locator "假常量" note "只声明命题常量，不断言它成立"

def 非 : Prop → Prop := λ (p : Prop) := p → 假

-- 定理：改判 "p → ¬¬p"
def 引入 : ∀ (p : Prop), p → 非 (非 p) :=
  λ (p : Prop) := λ (h : p) := λ (n : 非 p) := n h

#check 引入 (下雨 今天) 今天确实下雨
