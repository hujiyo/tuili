  params x : cn.constitution.人
  premise cn.constitution.公民 x
  conclude cn.constitution.结社自由 x
  source text "宪法" locator "第三十五条" version "2018"
         quote "中华人民共和国公民有言论、出版、集会、结社、游行、示威的自由。"
