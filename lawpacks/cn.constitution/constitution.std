-- 中华人民共和国宪法官方包 v0.3.0：形式化第三十三至四十六条中的选定基本权利。
-- 第二章第一批为第三十四、三十六、三十八、四十至四十五条；第四十七至五十六条与国家机构章尚未形式化。
-- 不是整条或整部宪法的完整形式化；"非法""住宅""侵犯""年满十八周岁"等概念由案件事实或人的判断提供。
namespace cn.constitution

sort cn.constitution.人
sort cn.constitution.住宅

-- 第三十三条：国籍、公民、平等、权利与义务。
pred cn.constitution.中国国籍 : cn.constitution.人 → Prop
pred cn.constitution.公民 : cn.constitution.人 → Prop
pred cn.constitution.法律面前平等 : cn.constitution.人 → Prop
pred cn.constitution.享有宪法法定权利 : cn.constitution.人 → Prop
pred cn.constitution.负有宪法法定义务 : cn.constitution.人 → Prop

-- 第三十五条：六项自由。
pred cn.constitution.言论自由 : cn.constitution.人 → Prop
pred cn.constitution.出版自由 : cn.constitution.人 → Prop
pred cn.constitution.集会自由 : cn.constitution.人 → Prop
pred cn.constitution.结社自由 : cn.constitution.人 → Prop
pred cn.constitution.游行自由 : cn.constitution.人 → Prop
pred cn.constitution.示威自由 : cn.constitution.人 → Prop

-- 第三十七条：人身自由与三类侵害事实。
pred cn.constitution.非法拘禁 : cn.constitution.人 → Prop
pred cn.constitution.非法逮捕 : cn.constitution.人 → Prop
pred cn.constitution.非法搜查身体 : cn.constitution.人 → Prop
pred cn.constitution.人身自由受侵犯 : cn.constitution.人 → Prop

-- 第三十九条：住宅与两类侵害事实。
pred cn.constitution.非法搜查 : cn.constitution.人 → cn.constitution.住宅 → Prop
pred cn.constitution.非法侵入 : cn.constitution.人 → cn.constitution.住宅 → Prop
pred cn.constitution.住宅受侵犯 : cn.constitution.人 → cn.constitution.住宅 → Prop

-- 第四十六条：受教育权与受教育义务。
pred cn.constitution.受教育权 : cn.constitution.人 → Prop
pred cn.constitution.受教育义务 : cn.constitution.人 → Prop

rule cn.constitution.中国国籍即公民 :
  params x : cn.constitution.人
  premise cn.constitution.中国国籍 x
  conclude cn.constitution.公民 x
  source text "宪法" locator "第三十三条" version "2018"
         quote "凡具有中华人民共和国国籍的人都是中华人民共和国公民。中华人民共和国公民在法律面前一律平等。国家尊重和保障人权。任何公民享有宪法和法律规定的权利，同时必须履行宪法和法律规定的义务。"
         url "http://www.npc.gov.cn/c2/c30834/201905/t20190521_281393.html"
         jurisdiction "CN" retrieved_at "2026-11-22"
         hash "sha256:b3b96295038c697e1f823b1718ac677af3aeb47066c591eb21c8049ac375ab8f"

rule cn.constitution.公民法律面前平等 :
  params x : cn.constitution.人
  premise cn.constitution.公民 x
  conclude cn.constitution.法律面前平等 x
  source text "宪法" locator "第三十三条" version "2018"
         quote "凡具有中华人民共和国国籍的人都是中华人民共和国公民。中华人民共和国公民在法律面前一律平等。国家尊重和保障人权。任何公民享有宪法和法律规定的权利，同时必须履行宪法和法律规定的义务。"
         url "http://www.npc.gov.cn/c2/c30834/201905/t20190521_281393.html"
         jurisdiction "CN" retrieved_at "2026-11-22"
         hash "sha256:b3b96295038c697e1f823b1718ac677af3aeb47066c591eb21c8049ac375ab8f"

